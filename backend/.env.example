# Copy this file to .env and fill in real values. Never commit the real .env.

# PostgreSQL connection. For AWS RDS add ?sslmode=require at the end.
DATABASE_URL=postgresql://pharma_app:CHANGE_ME@localhost:5432/pharma_demo

# Your Anthropic API key (from the Claude Console).
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# Secret used to sign login tokens. At least 32 characters, random, and never shared.
# Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everybody out.
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS

# The one web address allowed to call this API from a browser (no trailing slash).
# Local testing: http://localhost:5500
ALLOWED_ORIGIN=http://localhost:5500

# Optional. Claude model id; defaults to claude-opus-5-5.
CLAUDE_MODEL=claude-opus-5-5
